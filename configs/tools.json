{
  "tools": [
    {
      "class_name": "shopping_grpo.training.grpo.adapter.tools.ShopSimulatorTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "search_products",
          "description": "仅当最新 observation 显示“搜索功能是否可用: True”时搜索。query 应简洁，包含品类和最有区分度的品牌、型号、功能或规格；不得重复相同查询或机械复制整段需求。",
          "parameters": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              }
            },
            "required": [
              "query"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "shopping_grpo.training.grpo.adapter.tools.ShopSimulatorTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "open_product",
          "description": "打开最新 observation 当前搜索结果中列出的候选商品以核验价格、功能和规格；asin 必须原样取自该页面。",
          "parameters": {
            "type": "object",
            "properties": {
              "asin": {
                "type": "string"
              }
            },
            "required": [
              "asin"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "shopping_grpo.training.grpo.adapter.tools.ShopSimulatorTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "select_option",
          "description": "为当前候选补齐所有影响可购买 variant 的必要规格轴；value 必须来自最新 observation，同一规格轴只选一个值，不得选择导航按钮或历史页面中的值。选择后应按完整 variant 的实际价格重新检查预算。",
          "parameters": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          }
        }
      }
    },
