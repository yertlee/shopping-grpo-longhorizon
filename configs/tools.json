      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "think",
          "description": "不要调用 think 工具；它不与商店交互且会浪费有限步骤。请直接选择一个能带来新证据的购物工具。",
          "parameters": {
            "type": "object",
            "properties": {
              "note": {
                "type": "string"
              }
            },
            "required": [
              "note"
            ],
