    },
    {
      "class_name": "shopping_grpo.training.grpo.adapter.tools.ShopSimulatorTool",
      "config": {
        "type": "native"
      },
      "tool_schema": {
        "type": "function",
        "function": {
          "name": "finish_without_purchase",
          "description": "主动结束且不购买，这不是成功。经过多次有实质差异的搜索和多个候选核验，仍没有可接受商品，并且当前没有明显值得继续核验的候选时调用；是否达到资格由环境判断。",
          "parameters": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "no_suitable_product"
                ]
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "class_name": "shopping_grpo.training.grpo.adapter.tools.ShopSimulatorTool",
